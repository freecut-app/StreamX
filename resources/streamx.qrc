<RCC>
  <qresource prefix="/theme">
    <file alias="dark.qss">theme/dark.qss</file>
  </qresource>
  <qresource prefix="/icons">
    <file alias="streamx.png">icons/streamx.png</file>
  </qresource>
  <qresource prefix="/control">
    <file alias="remote.html">control/remote.html</file>
  </qresource>
</RCC>
